:188,"role":"line","x":12,"page":1,"width":42},{"height":22,"side":"right","index":7,"y":48,"role":"line","x":286,"page":1,"width":42},{"height":22,"side":"right","index":8,"y":76,"role":"line","x":286,"page":1,"width":42},{"height":22,"side":"right","index":9,"y":104,"role":"line","x":286,"page":1,"width":42},{"height":22,"side":"right","index":10,"y":132,"role":"line","x":286,"page":1,"width":42},{"height":22,"side":"right","index":11,"y":160,"role":"line","x":286,"page":1,"width":42},{"height":22,"side":"right","index":12,"y":188,"role":"line","x":286,"page":1,"width":42}]},"sample_preset":{"label":"Hotel front-desk demo","notes":"Safe demo values for a typical hotel PBX. Load via Quick-Provisioner Settings \u2192 Load Examples.","buttons":[{"index":1,"type":"line","value":"101","label":"Front Desk"},{"index":2,"type":"blf","value":"102","label":"Housekeeping"},{"index":3,"type":"blf","value":"103","label":"Manager"},{"index":4,"type":"speed_dial","value":"*97","label":"Voicemail"},{"index":5,"type":"speed_dial","value":"0","label":"Operator"}]}} }}
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<PHONE_CONFIG>
{{#lines}}
{{#has_sip_server}}
  <!-- Standalone mode: Full SIP registration configured -->
  <reg
    reg.{{line_index}}.label="{{label}}"
    reg.{{line_index}}.displayName="{{display_name}}"
    reg.{{line_index}}.address="{{user_name}}"
    reg.{{line_index}}.type="private"
    reg.{{line_index}}.lineKeys="1"
    reg.{{line_index}}.auth.userId="{{auth_name}}"
    reg.{{line_index}}.auth.password="{{password}}"
    reg.{{line_index}}.server.1.address="{{sip_server}}"
    reg.{{line_index}}.server.1.port="{{sip_port}}"
    reg.{{line_index}}.server.1.transport="{{sip_transport_mode}}"
    reg.{{line_index}}.server.1.register="1"
    reg.{{line_index}}.server.1.expires="{{expires}}"
{{#has_voicemail}}
    msg.mwi.{{line_index}}.subscribe="{{user_name}}"
    msg.mwi.{{line_index}}.callBackMode="registration"
    msg.mwi.{{line_index}}.callBack="{{voicemail_number}}"
{{/has_voicemail}}
{{#has_auto_answer}}
    reg.{{line_index}}.autoAnswerAll="{{auto_answer}}"
{{/has_auto_answer}}
{{#has_cfw_always}}
    reg.{{line_index}}.forward.all.enable="1"
    reg.{{line_index}}.forward.all.contact="{{cfw_always}}"
{{/has_cfw_always}}
{{#has_cfw_busy}}
    reg.{{line_index}}.forward.busy.enable="1"
    reg.{{line_index}}.forward.busy.contact="{{cfw_busy}}"
{{/has_cfw_busy}}
{{#has_cfw_no_answer}}
    reg.{{line_index}}.forward.noanswer.enable="1"
    reg.{{line_index}}.forward.noanswer.contact="{{cfw_no_answer}}"
{{/has_cfw_no_answer}}
  />
{{/has_sip_server}}
{{^has_sip_server}}
  <!-- DMS mode: Registration disabled – DMS server will provide SIP credentials -->
  <reg />
{{/has_sip_server}}
{{/lines}}
{{#has_outbound_proxy}}
  <voIpProt
    voIpProt.SIP.outboundProxy.address="{{outbound_proxy_host}}"
    voIpProt.SIP.outboundProxy.port="{{outbound_proxy_port}}"
  />
{{/has_outbound_proxy}}
{{#has_dnd}}
  <feature
    feature.presence.enabled="1"
    feature.directedCallPickup.enabled="1"
    feature.enhancedFeatureKeys.enabled="1"
    feature.doNotDisturb.enabled="{{dnd_enabled}}"
    dnd.default="{{dnd_enabled}}"
  />
{{/has_dnd}}
{{^has_dnd}}
  <feature
    feature.presence.enabled="1"
    feature.directedCallPickup.enabled="1"
    feature.enhancedFeatureKeys.enabled="1"
  />
{{/has_dnd}}
{{#has_call_waiting}}
  <callWaiting
    call.waiting.enable="{{call_waiting}}"
  />
{{/has_call_waiting}}
{{#has_dial_plan}}
  <dialplan
    dialplan.digitmap="{{dial_plan}}"
    dialplan.digitmap.timeOut="3|3"
  />
{{/has_dial_plan}}
{{#has_poly_line_key_assignments}}
  <lineKey
    lineKey.reassignment.enabled="1"
{{#poly_two_column_display}}
    up.numOfDisplayColumns="2"
{{/poly_two_column_display}}
{{#poly_line_key_assignments}}
    lineKey.{{position}}.category="{{category}}"
{{#has_index}}
    lineKey.{{position}}.index="{{index}}"
{{/has_index}}
{{/poly_line_key_assignments}}
  />
{{/has_poly_line_key_assignments}}
{{#has_attendant_keys}}
  <attendant
    attendant.reg="1"
{{#attendant_keys}}
    attendant.resourceList.{{position}}.address="sip:{{key_value}}@{{sip_server}}"
    attendant.resourceList.{{position}}.label="{{key_label}}"
    attendant.resourceList.{{position}}.callAddress="sip:{{key_value}}@{{sip_server}}"
    attendant.resourceList.{{position}}.server="{{sip_server}}"
    attendant.resourceList.{{position}}.type="normal"
{{/attendant_keys}}
  />
{{/has_attendant_keys}}
{{#has_speed_dial_keys}}
  <speedDial
{{#speed_dial_keys}}
    speedDial.{{position}}.address="{{key_value}}"
    speedDial.{{position}}.label="{{key_label}}"
{{/speed_dial_keys}}
  />
{{/has_speed_dial_keys}}
  <qos
    qos.ethernet.callControl.user_priority="5"
    qos.ip.callControl.dscp="46"
  />
{{#wallpaper_url}}
  <bg>
    <bg.background
      bg.background.enabled="1"
    />
    <!-- Force custom background selection so wallpaper applies on boot.
         Keep both generic and VVX1500-specific keys for older firmware compatibility.
         .set="1" required or Poly ignores selection after factory reset. -->
    <bg.color
      bg.color.selection.set="1"
      bg.color.selection="2,1"
      bg.VVX_1500.color.selection.set="1"
      bg.VVX_1500.color.selection="2,1"
    >
      <bg.color.bm
        bg.color.bm.1.name.set="1"
        bg.color.bm.1.name="{{wallpaper_url}}"
        bg.VVX_1500.color.bm.1.name.set="1"
        bg.VVX_1500.color.bm.1.name="{{wallpaper_url}}"
      />
    </bg.color>
  </bg>
{{/wallpaper_url}}
  <prov
    prov.quickSetup.enabled="0"
    prov.quickSetup.limitServerDetails="1"
  />
  <voice
    voice.codecPref.G7221.16kbps="0"
    voice.codecPref.G7221.24kbps="0"
    voice.codecPref.G7221.32kbps="0"
    voice.codecPref.G7221_C.24kbps="0"
    voice.codecPref.G7221_C.32kbps="0"
    voice.codecPref.G7221_C.48kbps="0"
    voice.codecPref.Siren14.24kbps="0"
    voice.codecPref.Siren14.32kbps="0"
    voice.codecPref.Siren14.48kbps="0"
    voice.codecPref.Siren22.32kbps="0"
    voice.codecPref.Siren22.48kbps="0"
    voice.codecPref.Siren22.64kbps="0"
    voice.codecPref.G722="1"
    voice.codecPref.G711_Mu="2"
    voice.codecPref.G711_A="3"
    voice.codecPref.G729_AB="0"
  />
  <video
    video.enable="{{video_enable}}"
    video.autoStartVideoTx="{{video_auto_start}}"
  />

{{#is_kid_friendly}}
  <!-- Kid-friendly mode: keep calling; lock down menus, browser, and advanced features -->
  <feature
    feature.enhancedFeatureKeys.enabled="1"
    feature.presence.enabled="0"
    feature.directedCallPickup.enabled="0"
    feature.doNotDisturb.enabled="0"
    feature.callList.enabled="0"
    feature.callListMissed.enabled="0"
    feature.callListPlaced.enabled="0"
    feature.callListReceived.enabled="0"
    feature.messaging.enabled="0"
    feature.urlDialing.enabled="0"
    feature.nwayConference.enabled="0"
    feature.corporateDirectory.enabled="0"
    feature.callRecording.enabled="0"
  />
  <call
    call.transfer.blindAllowed="0"
    call.transfer.consultativeAllowed="0"
  />
  <!-- Hide Applications / HTML browser entry points -->
  <homeScreen
    homeScreen.application.enable="0"
  />
  <mb
    mb.main.home=""
    mb.idleDisplay.home=""
  />
  <apps
    apps.statefulTelephone.enabled="0"
    apps.push.messageAlert.enabled="0"
  />
{{/is_kid_friendly}}

{{#has_screensaver_timeout}}
  <screensaver
    idleTimeout.enable="1"
    idleTimeout.timeout="{{screensaver_timeout}}"
  />
{{/has_screensaver_timeout}}
  <tcpIpApp
    tcpIpApp.sntp.address="{{ntp_server}}"
    tcpIpApp.sntp.gmtOffset="{{gmt_offset}}"
    tcpIpApp.sntp.daylightSavings.enable="{{dst_enable}}"
  />
{{#has_custom_ringtone}}
  <se.rt>
    <se.rt.file se.rt.file.1.name="{{ringtone_url}}" />
  </se.rt>
{{/has_custom_ringtone}}
{{#has_cdp_lldp}}
  <lldp
    lldp.enable="{{cdp_lldp_enabled}}"
    cdp.enable="{{cdp_lldp_enabled}}"
  />
{{/has_cdp_lldp}}
{{#has_syslog}}
  <log
    device.syslog.serverName="{{syslog_server}}"
    device.syslog.transport="UDP"
    device.syslog.renderLevel="5"
  />
{{/has_syslog}}
{{#has_phonebook}}
  <!-- Local contact directory: phone fetches {mac}-directory.xml from provisioning server.
       dir.corp.* is LDAP-only and must NOT point at HTTP XML phonebooks. -->
  <dir
    dir.local.readonly="1"
    feature.directory.enabled="1"
  />
  <voIpProt
    voIpProt.SIP.specialEvent.checkSync.downloadDirectory="1"
  />
{{/has_phonebook}}
  <DEVICE
    device.set="1"
{{#has_admin_password}}
    device.auth.localAdminPassword.set="1"
    device.auth.localAdminPassword="{{admin_password}}"
{{/has_admin_password}}
    device.prov.serverName="{{provisioning_base}}"
    device.prov.serverType="HTTP"
    device.prov.user="{{provision_user}}"
    device.prov.password="{{provision_pass}}"
    <!-- 2 = use Server menu / configured serverName only — ignore DHCP opt 66/160 (Telstra DMS). -->
    device.dhcp.bootSrvUseOpt.set="1"
    device.dhcp.bootSrvUseOpt="2"
    device.prov.ztpEnabled.set="1"
    device.prov.ztpEnabled="0"
{{#has_polycom_contacts_directory}}
    device.prov.contactsDirectory="{{polycom_contacts_directory}}"
{{/has_polycom_contacts_directory}}
{{#has_web_ui}}
    device.web.enabled="{{web_ui_enabled}}"
{{/has_web_ui}}
  />
{{#has_web_ui}}
  <httpd
    httpd.enabled="{{web_ui_enabled}}"
    httpd.cfg.enabled="{{web_ui_enabled}}"
    httpd.cfg.secureTunnelRequired="0"
  />
{{/has_web_ui}}
{{#has_firmware}}
  <UPDATER
    updater.autoPowerUp.set="1"
    updater.autoPowerUp="1"
    updater.application.url.set="1"
    updater.application.url="{{firmware_url}}"
  />
{{/has_firmware}}
{{^has_firmware}}
  <!-- Freeze software: clear any prior updater URL and do not auto-upgrade on boot. -->
  <UPDATER
    updater.autoPowerUp.set="1"
    updater.autoPowerUp="0"
    updater.application.url.set="1"
    updater.application.url=""
  />
{{/has_firmware}}
</PHONE_CONFIG>
